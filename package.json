{
  "name": "fanui-workspace",
  "private": true,
  "scripts": {
    "test": "npm run test:unit && npm run test:contracts",
    "test:unit": "vitest run packages/react/test",
    "test:contracts": "node --test tests/*.test.mjs && node tests/skill-behavior/run.mjs",
    "test:acceptance": "playwright test",
    "test:acceptance:target": "playwright test tests/acceptance/fanui.acceptance.spec.ts",
    "test:acceptance:fixtures": "playwright test tests/acceptance/fixture-contract.spec.ts --project=chromium-1440x1000-light",
    "verify:skill": "node scripts/verify-skill.mjs",
    "verify:all": "npm run verify:skill && npm run typecheck && npm test && npm run test:acceptance",
    "review:snapshot": "node scripts/review-snapshot.mjs",
    "sync:skill": "node scripts/sync-skill.mjs",
    "typecheck": "tsc -p packages/react/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "ajv": "^8.20.0",
    "jsdom": "^26.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
